# Copy to .env for the real-LLM path. Defaults (no .env) run the deterministic
# mock provider — the demo never dies.
#
# VIVA_LLM_PROVIDER=mock | openai | groq
# VIVA_LLM_MODEL=
# VIVA_LLM_BASE_URL=
# VIVA_OPENAI_API_KEY=
# VIVA_GROQ_API_KEY=
# VIVA_LLM_TEMPERATURE=0.2

# Runtime tuning (safe defaults shown)
# VIVA_RATE_LIMIT_PER_MINUTE=60
# VIVA_SESSION_TTL_HOURS=2.0
# VIVA_MAX_TURNS=50
# VIVA_DEFAULT_QUESTIONS=8
